/**
 * Wrangler 示例配置 (仓库内始终保持示例状态) / Wrangler example config (the repo keeps this file as an example)
 *
 * 生产部署不要直接修改本文件, 使用临时配置文件 / For production deployments, do not edit this file; use a throwaway config:
 *   1. cp wrangler.jsonc wrangler.prod.jsonc        (wrangler.prod.jsonc 已被 .gitignore 忽略 / gitignored)
 *   2. 编辑临时配置: name / routes (你的自定义域名) / 按需开启可观测
 *      edit the throwaway config: name / routes (your custom domains) / enable observability as needed
 *   3. npx wrangler deploy --config wrangler.prod.jsonc
 *   4. 部署后设置访问令牌 / set the access token after deploying:
 *      npx wrangler secret put PROXY_TOKEN --config wrangler.prod.jsonc
 *      (未设置时 fail-closed, 拒绝所有代理请求 / until then, fail-closed: every proxy request is rejected)
 *   5. rm wrangler.prod.jsonc
 *
 * 注意: PROXY_TOKEN 只以 secret 形式存在, 不要放入 vars / note: PROXY_TOKEN exists only as a secret, never put it in vars
 * (vars 与 secret 同名时, 每次 deploy 都会用 vars 值覆盖远程 secret; 类型见 src/env.d.ts)
 * (a same-name vars/secret pair makes every deploy overwrite the remote secret with the vars value; types live in src/env.d.ts)
 *
 * 更多配置项 / more options: https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "cloudflare-urlproxy",
	"main": "src/index.ts",
	"compatibility_date": "2026-09-25",
	// 可观测性默认全部关闭; 生产部署如需日志与错误堆栈还原, 在临时配置中开启
	// all observability off by default; enable it in the throwaway config if you need logs and symbolized stack traces
	"observability": {
		"enabled": false
	},
	"upload_source_maps": false,

	// 生产部署只通过自定义域名暴露: 关闭 workers.dev 默认域名与预览 URL
	// production is exposed via custom domains only: workers.dev route and preview URLs stay off
	// (wrangler >= 4.44.0 时 preview_urls 默认跟随 workers_dev, 此处显式关闭以确保任意版本行为一致)
	// (on wrangler >= 4.44.0 preview_urls defaults to workers_dev; set it explicitly so behavior is version-independent)
	// https://developers.cloudflare.com/workers/configuration/routing/workers-dev/
	// https://developers.cloudflare.com/workers/versions-and-deployments/preview-urls/
	"workers_dev": false,
	"preview_urls": false,

	// 自定义域名 (示例占位, 部署时在临时配置中替换为你自己的域名)
	// custom domains (example placeholder; replace with your own in the throwaway config)
	// https://developers.cloudflare.com/workers/configuration/routing/custom-domains/
	"routes": [{ "pattern": "proxy.example.com", "custom_domain": true }],

	/**
	 * 环境变量 (vars 明文, 机密一律用 secret) / environment variables (vars are plaintext; secrets are for sensitive data)
	 * https://developers.cloudflare.com/workers/configuration/secrets/
	 */
	"vars": {
		// 可选: 额外允许读取代理响应的跨域来源, 逗号分隔, 如 "https://app.example.com"
		// optional: extra origins allowed to read proxied responses, comma-separated, e.g. "https://app.example.com"
		"ALLOWED_ORIGINS": ""
	}
}
